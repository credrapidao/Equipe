rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /promoters/{promoterId} {
      allow read: if true;
      allow create: if isValidPromoter(request.resource.data);
      allow update: if isValidPromoter(request.resource.data);
      allow delete: if true;

      match /attendance/{attendanceId} {
        allow read: if true;
        allow create: if isValidAttendance(request.resource.data);
        allow update: if true;
        allow delete: if true;
      }

      match /advances/{advanceId} {
        allow read: if true;
        allow create: if isValidAdvance(request.resource.data);
        allow update: if true;
        allow delete: if true;
      }

      match /leads/{leadId} {
        allow read, write: if true;
      }
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /config/{configId} {
      allow read, write: if true;
    }

    match /teams/{teamId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read: if true;
      allow create: if isValidEmployee(request.resource.data);
      allow update: if isValidEmployee(request.resource.data);
      allow delete: if true;

      match /absences/{absenceId} {
        allow read: if true;
        allow create: if isValidEmployeeAbsence(request.resource.data);
        allow update: if true;
        allow delete: if true;
      }

      match /advances/{advanceId} {
        allow read: if true;
        allow create: if isValidEmployeeAdvance(request.resource.data);
        allow update: if true;
        allow delete: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    function isValidPromoter(data) {
      return data.keys().hasAll(['name', 'document', 'pixKey', 'pixKeyType']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.document is string && data.document.size() > 0 && data.document.size() <= 20 &&
             data.pixKey is string && data.pixKey.size() > 0 && data.pixKey.size() <= 100 &&
             data.pixKeyType in ['CPF', 'CNPJ', 'Email', 'Phone', 'Random'];
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['promoterId', 'date', 'status', 'paymentStatus']) &&
             data.promoterId is string &&
             data.date is string &&
             data.status in ['present', 'absent', 'half-day'] &&
             data.paymentStatus in ['pending', 'paid'];
    }

    function isValidAdvance(data) {
      return data.keys().hasAll(['promoterId', 'amount', 'date', 'status']) &&
             data.promoterId is string &&
             data.amount is number && data.amount > 0 &&
             data.date is string &&
             data.status in ['pending', 'paid'];
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'document', 'pixKey', 'pixKeyType', 'baseSalary', 'active']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.document is string && data.document.size() > 0 && data.document.size() <= 20 &&
             data.pixKey is string && data.pixKey.size() > 0 && data.pixKey.size() <= 100 &&
             data.pixKeyType in ['CPF', 'CNPJ', 'Email', 'Phone', 'Random'] &&
             data.baseSalary is number && data.baseSalary >= 0 &&
             data.active is bool;
    }

    function isValidEmployeeAbsence(data) {
      return data.keys().hasAll(['employeeId', 'date', 'discount', 'recordedAt']) &&
             data.employeeId is string &&
             data.date is string &&
             data.discount is number && data.discount >= 0 &&
             data.recordedAt is string;
    }

    function isValidEmployeeAdvance(data) {
      return data.keys().hasAll(['employeeId', 'amount', 'date', 'status', 'recordedAt']) &&
             data.employeeId is string &&
             data.amount is number && data.amount > 0 &&
             data.date is string &&
             data.status in ['pending', 'paid'] &&
             data.recordedAt is string;
    }
  }
}
